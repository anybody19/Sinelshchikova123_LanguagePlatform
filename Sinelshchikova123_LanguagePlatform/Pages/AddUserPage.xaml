<Page x:Class="Sinelshchikova123_LanguagePlatform.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Логин" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox x:Name="TBLogin" Grid.Row="0" Grid.Column="1" Text="{Binding Login}" Margin="5"/>

        <TextBlock Text="Пароль" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox x:Name="TBPass" Grid.Row="1" Grid.Column="1" Text="{Binding Password}" Margin="5"/>

        <TextBlock Text="Роль" Grid.Row="2" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbRole" Grid.Row="2" Grid.Column="1" Margin="5" SelectedValue="{Binding Role}">
            <ComboBoxItem Content="Admin"/>
            <ComboBoxItem Content="User"/>
        </ComboBox>

        <TextBlock Text="ФИО" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox x:Name="TBFio" Grid.Row="3" Grid.Column="1" Text="{Binding FIO}" Margin="5"/>

        <TextBlock Text="Фото (путь)" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBox x:Name="TBPhoto" Grid.Row="4" Grid.Column="1" Text="{Binding Photo}" Margin="5"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Сохранить" Click="ButtonSave_Click" Width="120"/>
            <Button Content="Очистить" Click="ButtonClean_Click" Width="120"/>
        </StackPanel>
    </Grid>
</Page>