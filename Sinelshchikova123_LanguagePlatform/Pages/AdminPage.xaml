<Page x:Class="Sinelshchikova123_LanguagePlatform.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F3F4F6">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Панель администратора" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            <Button x:Name="BtnTab1" Content="Пользователи" Width="250" Height="45" Margin="10" Click="BtnTab1_Click"/>
            <Button x:Name="BtnTab2" Content="Языки" Width="250" Height="45" Margin="10" Click="BtnTab2_Click"/>
            <Button x:Name="BtnTab3" Content="Прогресс (Платежи)" Width="250" Height="45" Margin="10" Click="BtnTab3_Click"/>
            <Button x:Name="BtnTab4" Content="Диаграммы и экспорт" Width="250" Height="45" Margin="10" Click="BtnTab4_Click" Background="#10B981"/>
        </StackPanel>
    </Grid>
</Page>