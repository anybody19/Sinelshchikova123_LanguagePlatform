<Page x:Class="Sinelshchikova123_LanguagePlatform.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
    <Grid Background="#F3F4F6">
        <!-- Увеличили высоту с 500 до 580, чтобы всё влезло -->
        <Border Background="White" CornerRadius="10" Width="400" Height="580" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Margin="30,20,30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Заголовок -->
                    <RowDefinition Height="Auto"/>
                    <!-- Логин -->
                    <RowDefinition Height="Auto"/>
                    <!-- Пароль -->
                    <RowDefinition Height="Auto"/>
                    <!-- Подтверждение -->
                    <RowDefinition Height="Auto"/>
                    <!-- ФИО -->
                    <RowDefinition Height="Auto"/>
                    <!-- Роль -->
                    <RowDefinition Height="*"/>
                    <!-- Кнопки -->
                </Grid.RowDefinitions>

                <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Label Content="Логин" Grid.Row="1"/>
                <TextBox x:Name="txtbxLog" Grid.Row="1" Margin="0,25,0,10"/>

                <Label Content="Пароль" Grid.Row="2"/>
                <PasswordBox x:Name="passBxFrst" Grid.Row="2" Margin="0,25,0,10"/>

                <Label Content="Подтвердите пароль" Grid.Row="3"/>
                <PasswordBox x:Name="passBxScnd" Grid.Row="3" Margin="0,25,0,10"/>

                <Label Content="ФИО" Grid.Row="4"/>
                <TextBox x:Name="txtbxFIO" Grid.Row="4" Margin="0,25,0,10"/>

                <!-- Блок выбора роли -->
                <Label Content="Роль" Grid.Row="5"/>
                <ComboBox x:Name="comboBxRole" Grid.Row="5" Margin="0,25,0,10" SelectedIndex="0">
                    <ComboBoxItem Content="User" />
                    <ComboBoxItem Content="Admin" />
                </ComboBox>

                
                <StackPanel Grid.Row="6" Orientation="Vertical" VerticalAlignment="Bottom">
                    <Button x:Name="regButton" Content="Зарегистрироваться" Click="regButton_Click" Margin="0,5,0,5"/>
                    <Button Content="Назад" Click="ButtonBack_Click" Background="Transparent" Foreground="Gray"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>