<Page x:Class="Sinelshchikova123_LanguagePlatform.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBox Text="Поиск по ФИО:" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" FontWeight="Bold"/>
            <TextBox x:Name="fioFilterTextBox" Margin="5" Width="150" TextChanged="fioFilterTextBox_TextChanged"/>

            <TextBox Text="Сортировка:" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" FontWeight="Bold" Margin="10,0,0,0"/>
            <ComboBox x:Name="sortComboBox" SelectionChanged="sortComboBox_SelectionChanged" Margin="5" Width="120" SelectedIndex="0">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>

            <CheckBox x:Name="onlyAdminCheckBox" Content="Только админы" VerticalAlignment="Center" Margin="10,0,0,0" Checked="onlyAdminCheckBox_Checked" Unchecked="onlyAdminCheckBox_Unchecked"/>
        </WrapPanel>

        <ListView x:Name="ListUser" Grid.Row="1" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Margin="10" Width="200" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="200"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding FIO}" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" FontWeight="Bold"/>

                            <Image Grid.Row="1" Stretch="UniformToFill" HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="Photo">
                                        <Binding.TargetNullValue>
                                            <ImageSource>/images/default.png</ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>

                            <TextBlock Grid.Row="2" Text="{Binding Role}" HorizontalAlignment="Center" Foreground="Gray" Margin="0,5,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>